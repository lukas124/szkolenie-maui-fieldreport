<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:FieldReport.App.Pages"
             xmlns:conv="clr-namespace:FieldReport.App.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FieldReport.App.App">
    <!-- Zasoby globalne: kolory i style dostępne w całej aplikacji -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Templates/PageTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Konwertery: znaczenie (enum) → wygląd (kolor z palety) -->
            <conv:PriorityToColorConverter x:Key="PriorityToColor"
                High="{StaticResource DangerColor}" Normal="{StaticResource WarningColor}" Low="{StaticResource NeutralColor}" />
            <conv:StatusToColorConverter x:Key="StatusToColor"
                New="{StaticResource InfoColor}" InProgress="{StaticResource WarningColor}" Done="{StaticResource SuccessColor}" />

            <!-- Konwertery ogólne z CommunityToolkit.Maui (klucz = nazwa klasy) -->
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />       <!-- jest wartość? → true -->
            <toolkit:IsNullConverter x:Key="IsNullConverter" />             <!-- brak wartości? → true -->
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" /> <!-- true ↔ false -->

            <Style TargetType="pages:BasePage" ApplyToDerivedTypes="True" BasedOn="{StaticResource PageStyle}">
                <Setter Property="ControlTemplate" Value="{StaticResource PageTemplate}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
