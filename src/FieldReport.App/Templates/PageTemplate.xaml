<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Szablony kontrolek (ControlTemplate) wspólne dla całej aplikacji. Słownik jest dołączony w App.xaml (MergedDictionaries).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:pages="clr-namespace:FieldReport.App.Pages"
                    xmlns:nav="clr-namespace:FieldReport.Core.Navigation;assembly=FieldReport.Core">

    <!--
      Szablon strony (ControlTemplate): nagłówek + treść strony (ContentPresenter) + globalny wskaźnik ładowania
      (widoczny, gdy ViewModel ma IsBusy = true). Każda BasePage dostaje go ze stylu w App.xaml.
      Nagłówek rysuje MAUI, więc wygląda tak samo na Androidzie i iOS (systemowy pasek nawigacji jest ukryty — Styles.xaml).
      Binding z Source={RelativeSource TemplatedParent} czyta właściwości strony, która używa szablonu (Title, CanNavigateBack…).
      Z lewej strzałka „wstecz” (CanNavigateBack) albo „X” (ShowCloseButton), z prawej ikona akcji (ActionIcon).
    -->
    <ControlTemplate x:Key="PageTemplate">
        <Grid RowDefinitions="Auto,*" x:DataType="pages:BasePage"
              BindingContext="{Binding BindingContext, Source={RelativeSource TemplatedParent}}">
            <Grid ColumnDefinitions="56,*,56" HeightRequest="56"
                  IsVisible="{Binding IsHeaderVisible, Source={RelativeSource TemplatedParent}}">
                <ImageButton Source="{AppThemeBinding Light=icon_back_dark.png, Dark=icon_back_light.png}" Padding="16"
                             Command="{Binding BackButtonCommand, Source={RelativeSource TemplatedParent}}"
                             IsVisible="{Binding CanNavigateBack, Source={RelativeSource TemplatedParent}}"
                             AutomationId="HeaderBack" />
                <ImageButton Source="{AppThemeBinding Light=icon_close_dark.png, Dark=icon_close_light.png}" Padding="16"
                             Command="{Binding CloseButtonCommand, Source={RelativeSource TemplatedParent}}"
                             IsVisible="{Binding ShowCloseButton, Source={RelativeSource TemplatedParent}}"
                             AutomationId="HeaderClose" />
                <Label Grid.Column="1" Text="{Binding Title, Source={RelativeSource TemplatedParent}}" Style="{StaticResource HeaderTitle}" />
                <ImageButton Grid.Column="2" Source="{Binding ActionIcon, Source={RelativeSource TemplatedParent}}" Padding="16"
                             Command="{Binding ActionCommand, Source={RelativeSource TemplatedParent}}"
                             IsVisible="{Binding HasAction, Source={RelativeSource TemplatedParent}}"
                             AutomationId="HeaderAction" />
                <!-- linia oddzielająca nagłówek od treści -->
                <BoxView Grid.ColumnSpan="3" HeightRequest="1" VerticalOptions="End" />
            </Grid>

            <ContentPresenter Grid.Row="1" />
            <ActivityIndicator Grid.Row="1" x:DataType="nav:BaseViewModel" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               WidthRequest="48" HeightRequest="48" />
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
