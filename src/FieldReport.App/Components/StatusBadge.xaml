<?xml version="1.0" encoding="utf-8" ?>
<!-- Kolor kropki: konwerter (ViewModel/komponent wystawia znaczenie, konwerter wygląd). Odznaka statusu zgłoszenia -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FieldReport.App.Components.StatusBadge"
             xmlns:components="clr-namespace:FieldReport.App.Components"
             x:Name="Root"
             x:DataType="components:StatusBadge">
    <Border Style="{StaticResource Badge}">
        <HorizontalStackLayout Spacing="6">
            <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                     Fill="{Binding Status, Source={x:Reference Root}, Converter={StaticResource StatusToColor}}" />
            <Label Text="{Binding Text, Source={x:Reference Root}}" Style="{StaticResource BadgeText}" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
