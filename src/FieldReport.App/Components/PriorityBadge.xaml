<?xml version="1.0" encoding="utf-8" ?>
<!-- Kolor kropki: konwerter (ViewModel/komponent wystawia znaczenie, konwerter wygląd). Odznaka priorytetu: komponent wystawia właściwości (Priority, Text), nie nawiguje i nie sięga do DI -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FieldReport.App.Components.PriorityBadge"
             xmlns:components="clr-namespace:FieldReport.App.Components"
             x:Name="Root"
             x:DataType="components:PriorityBadge">
    <Border Style="{StaticResource Badge}">
        <HorizontalStackLayout Spacing="6">
            <!-- Priority (enum) → konwerter → kolor kropki -->
            <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                     Fill="{Binding Priority, Source={x:Reference Root}, Converter={StaticResource PriorityToColor}}" />
            <!-- gotowy tekst z formattera: „Wysoki” -->
            <Label Text="{Binding Text, Source={x:Reference Root}}" Style="{StaticResource BadgeText}" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
