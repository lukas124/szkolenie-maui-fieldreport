<?xml version="1.0" encoding="utf-8" ?>
<!-- Playground: piaskownica do pokazów XAML (elementy = obiekty, atrybuty = właściwości) -->
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:FieldReport.App.Pages"
                xmlns:vm="clr-namespace:FieldReport.Core.ViewModels.Playground;assembly=FieldReport.Core"
                x:Class="FieldReport.App.Pages.PlaygroundPage"
                Title="Playground"
                CanNavigateBack="True">
    <!-- Playground: ViewModel tworzony w XAML (tylko w piaskownicy; strony aplikacji dostają go z DI) -->
    <pages:BasePage.BindingContext>
        <vm:CounterViewModel />
    </pages:BasePage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="Witaj w MAUI" Style="{StaticResource Headline}" />
            <Border Style="{StaticResource InputFrame}">
                <Entry x:Name="NameEntry" Placeholder="Imię" />
            </Border>
            <Label Text="{Binding Source={x:Reference NameEntry}, Path=Text, StringFormat='Cześć {0}!'}" />

            <!-- Markup extensions i właściwości dołączone -->
            <Label Text="// markup extensions" Style="{StaticResource SectionHeader}" Margin="0,16,0,0" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                    <Label Text="OnPlatform" Style="{StaticResource Caption}" />
                    <Label Grid.Column="1" Text="{OnPlatform Android='Android', iOS='iOS', Default='inna'}" />
                    <Label Grid.Row="1" Text="OnIdiom" Style="{StaticResource Caption}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{OnIdiom Phone='telefon', Tablet='tablet', Default='inne'}" />
                    <Label Grid.Row="2" Text="x:Reference" Style="{StaticResource Caption}" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Text="{Binding Source={x:Reference NameEntry}, Path=Text.Length, StringFormat='Liczba znaków: {0}', TargetNullValue='Liczba znaków: 0', FallbackValue='Liczba znaków: 0'}" />
                </Grid>
            </Border>

            <!-- MVVM: [ObservableProperty] + [RelayCommand] z CommunityToolkit.Mvvm -->
            <Label Text="// MVVM: CounterViewModel" Style="{StaticResource SectionHeader}" Margin="0,16,0,0" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding CountText}" Style="{StaticResource Title}" />
                    <Button Text="Kliknij" Command="{Binding IncrementCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
