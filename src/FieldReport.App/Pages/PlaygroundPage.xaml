<?xml version="1.0" encoding="utf-8" ?>
<!-- Playground: piaskownica do pokazów XAML (elementy = obiekty, atrybuty = właściwości) -->
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:FieldReport.App.Pages"
                xmlns:vm="clr-namespace:FieldReport.Core.ViewModels.Playground;assembly=FieldReport.Core"
                x:Class="FieldReport.App.Pages.PlaygroundPage"
                Title="Playground"
                CanNavigateBack="True">
    <!-- Playground: ViewModel tworzony w XAML (tylko w piaskownicy; strony aplikacji dostają go z DI) -->
    <pages:BasePage.BindingContext>
        <vm:CounterViewModel />
    </pages:BasePage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="Witaj w MAUI" Style="{StaticResource Headline}" />
            <Border Style="{StaticResource InputFrame}">
                <Entry x:Name="NameEntry" Placeholder="Imię" />
            </Border>
            <Label Text="{Binding Source={x:Reference NameEntry}, Path=Text, StringFormat='Cześć {0}!'}" />

            <!-- Markup extensions i właściwości dołączone -->
            <Label Text="// markup extensions" Style="{StaticResource SectionHeader}" Margin="0,16,0,0" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                    <Label Text="OnPlatform" Style="{StaticResource Caption}" />
                    <Label Grid.Column="1" Text="{OnPlatform Android='Android', iOS='iOS', Default='inna'}" />
                    <Label Grid.Row="1" Text="OnIdiom" Style="{StaticResource Caption}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{OnIdiom Phone='telefon', Tablet='tablet', Default='inne'}" />
                    <Label Grid.Row="2" Text="x:Reference" Style="{StaticResource Caption}" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Text="{Binding Source={x:Reference NameEntry}, Path=Text.Length, StringFormat='Liczba znaków: {0}', TargetNullValue='Liczba znaków: 0', FallbackValue='Liczba znaków: 0'}" />
                </Grid>
            </Border>

            <!-- Layouty: Grid (Auto, *, gwiazdki proporcjonalne), FlexLayout -->
            <Label Text="// Grid: Auto | * | 2*" Style="{StaticResource SectionHeader}" Margin="0,16,0,0" />
            <Grid ColumnDefinitions="Auto,*,2*" ColumnSpacing="8">
                <Border Style="{StaticResource Badge}"><Label Text="Auto" Style="{StaticResource BadgeText}" /></Border>
                <Border Grid.Column="1" Style="{StaticResource PendingBadge}"><Label Text="*" Style="{StaticResource PendingBadgeText}" HorizontalOptions="Center" /></Border>
                <Border Grid.Column="2" Style="{StaticResource PendingBadge}"><Label Text="2*" Style="{StaticResource PendingBadgeText}" HorizontalOptions="Center" /></Border>
            </Grid>

            <Label Text="// FlexLayout Wrap=&quot;Wrap&quot;" Style="{StaticResource SectionHeader}" Margin="0,16,0,0" />
            <FlexLayout Wrap="Wrap">
                <Border Style="{StaticResource Badge}" Margin="0,0,6,6"><Label Text="Grid" Style="{StaticResource BadgeText}" /></Border>
                <Border Style="{StaticResource Badge}" Margin="0,0,6,6"><Label Text="VerticalStackLayout" Style="{StaticResource BadgeText}" /></Border>
                <Border Style="{StaticResource Badge}" Margin="0,0,6,6"><Label Text="FlexLayout" Style="{StaticResource BadgeText}" /></Border>
                <Border Style="{StaticResource Badge}" Margin="0,0,6,6"><Label Text="ScrollView" Style="{StaticResource BadgeText}" /></Border>
                <Border Style="{StaticResource Badge}" Margin="0,0,6,6"><Label Text="CollectionView" Style="{StaticResource BadgeText}" /></Border>
                <Border Style="{StaticResource Badge}" Margin="0,0,6,6"><Label Text="Border" Style="{StaticResource BadgeText}" /></Border>
            </FlexLayout>

            <!-- MVVM: [ObservableProperty] + [RelayCommand] z CommunityToolkit.Mvvm -->
            <Label Text="// MVVM: CounterViewModel" Style="{StaticResource SectionHeader}" Margin="0,16,0,0" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding CountText}" Style="{StaticResource Title}" />
                    <Button Text="Kliknij" Command="{Binding IncrementCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Wątek UI: blokujące czekanie (Thread.Sleep) kontra await -->
            <Label Text="// wątek UI" Style="{StaticResource SectionHeader}" Margin="0,16,0,0" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="UiThreadStatus" Text="Kliknij i spróbuj przewinąć stronę." Style="{StaticResource Body}" />
                    <Button Text="Thread.Sleep(3000)" Style="{StaticResource SecondaryButton}" Clicked="OnBlockingClicked" />
                    <Button Text="await Task.Delay(3000)" Clicked="OnAwaitClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
