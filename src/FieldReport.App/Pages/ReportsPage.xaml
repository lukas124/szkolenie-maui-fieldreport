<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:FieldReport.App.Pages"
                xmlns:components="clr-namespace:FieldReport.App.Components"
                xmlns:loc="clr-namespace:FieldReport.App.MarkupExtensions"
                xmlns:vm="clr-namespace:FieldReport.Core.ViewModels;assembly=FieldReport.Core"
                xmlns:presentation="clr-namespace:FieldReport.Core.Presentation;assembly=FieldReport.Core"
                x:Class="FieldReport.App.Pages.ReportsPage"
                x:DataType="vm:ReportsViewModel"
                Title="{loc:Translate Reports_Title}"
                ActionIcon="{AppThemeBinding Light=icon_settings_dark.png, Dark=icon_settings_light.png}"
                ActionCommand="{Binding OpenSettingsCommand}">

    <Grid RowDefinitions="Auto,*">
    <!-- Brak połączenia z serwerem: dyskretny pasek nad listą (na liście tylko zgłoszenia czekające w telefonie) -->
    <Border Style="{StaticResource PendingBadge}" StrokeShape="Rectangle" Padding="16,10" IsVisible="{Binding IsOffline}"
            AutomationId="ReportsOffline">
        <Label Text="{loc:Translate Reports_Offline}" Style="{StaticResource PendingBadgeText}" />
    </Border>

    <!-- Lista zgłoszeń i synchronizacja: pull-to-refresh = wysłanie zgłoszeń czekających w telefonie + ponowne pobranie listy -->
    <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" AutomationId="ReportsRefresh">
    <!-- Nigdy CollectionView w ScrollView: lista sama się przewija i wirtualizuje elementy -->
    <CollectionView ItemsSource="{Binding Reports}" SelectionMode="None">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <BoxView HeightRequest="12" Color="Transparent" />
        </CollectionView.Header>
        <CollectionView.Footer>
            <BoxView HeightRequest="104" Color="Transparent" />
        </CollectionView.Footer>

        <!-- Pusty stan listy zgłoszeń -->
        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="40,0,40,60" Spacing="16" VerticalOptions="Center">
                <Image Source="empty_reports.png" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" />
                <Label Text="{loc:Translate Reports_Empty}" Style="{StaticResource Body}"
                       HorizontalTextAlignment="Center" FontSize="16">
                    <!-- Offline lista pokazuje tylko zgłoszenia czekające w telefonie — pusta lista nie znaczy „brak zgłoszeń” -->
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsOffline, Source={RelativeSource AncestorType={x:Type vm:ReportsViewModel}}}" Value="True">
                            <Setter Property="Text" Value="{loc:Translate Reports_EmptyOffline}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <!-- Karta zgłoszenia: Border + Grid (miniatura | tytuł + data | odznaki). Płasko: szablon × N elementów. -->
        <CollectionView.ItemTemplate>
            <!-- x:DataType w szablonie: kontekstem elementu listy jest ReportItem (nie ViewModel strony) -->
            <DataTemplate x:DataType="presentation:ReportItem">
                <!-- SwipeView: przesunięcie w lewo → „Usuń” (tylko niewysłane). Komenda z ViewModelu strony
                     (RelativeSource AncestorType), parametr = element listy ({Binding .}). -->
                <SwipeView Margin="16,0" BackgroundColor="Transparent">
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Reveal">
                            <!-- akcja widoczna tylko dla zgłoszeń, które można usunąć (CanDelete: nigdy niewysłane) -->
                            <SwipeItemView IsVisible="{Binding CanDelete}"
                                           Command="{Binding DeleteReportCommand, Source={RelativeSource AncestorType={x:Type vm:ReportsViewModel}}}"
                                           CommandParameter="{Binding .}">
                                <Border Style="{StaticResource SwipeAction}">
                                    <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                                        <Image Source="icon_delete.png" WidthRequest="24" HeightRequest="24" />
                                        <Label Text="{loc:Translate Reports_Delete}" Style="{StaticResource SwipeActionText}" />
                                    </VerticalStackLayout>
                                </Border>
                            </SwipeItemView>
                        </SwipeItems>
                    </SwipeView.RightItems>

                <!-- ramka karty: zaokrąglone tło ze stylu Card -->
                <Border Style="{StaticResource Card}" Padding="12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenReportCommand, Source={RelativeSource AncestorType={x:Type vm:ReportsViewModel}}}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <!-- 2 kolumny: miniatura 64 px | reszta; 3 wiersze: tytuł, data, odznaki -->
                    <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="4">
                        <!-- miniatura w kolumnie 0, przez 3 wiersze -->
                        <Border Grid.RowSpan="3" Style="{StaticResource Thumbnail}" VerticalOptions="Start">
                            <!-- brak zdjęcia (null) → obrazek zastępczy -->
                            <Image Source="{Binding ThumbnailSource, TargetNullValue='report_placeholder.png'}" Aspect="AspectFill" />
                        </Border>

                        <!-- kolumna 1, wiersz 0: tytuł zgłoszenia -->
                        <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                        <!-- kolumna 1, wiersz 1: data – gotowy tekst z formattera -->
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding CreatedAtText}" Style="{StaticResource Caption}" />

                        <!-- kolumna 1, wiersz 2: odznaki; Wrap = zawijaj do nowej linii, gdy brak miejsca -->
                        <FlexLayout Grid.Column="1" Grid.Row="2" Wrap="Wrap" Margin="0,6,0,0">
                            <!-- nasz komponent: kropka w kolorze priorytetu + tekst „Wysoki” -->
                            <components:PriorityBadge Priority="{Binding Priority}" Text="{Binding PriorityText}" Margin="0,0,6,6" />
                            <!-- to samo dla statusu: „Nowe”, „W trakcie”, „Zakończone” -->
                            <components:StatusBadge Status="{Binding Status}" Text="{Binding StatusText}" Margin="0,0,6,6" />
                            <!-- znacznik widoczny tylko dla niewysłanych (IsPendingSync == true) -->
                            <Border Style="{StaticResource PendingBadge}" IsVisible="{Binding IsPendingSync}" Margin="0,0,6,6">
                                <!-- tekst z zasobów: „Oczekuje na wysłanie” -->
                                <Label Text="{loc:Translate Reports_PendingSync}" Style="{StaticResource PendingBadgeText}" />
                            </Border>
                        </FlexLayout>
                    </Grid>
                </Border>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    </RefreshView>

    <!-- Lista zgłoszeń: „+” otwiera kreator nowego zgłoszenia (modal). Znak „+” to ikona SVG, więc jest dokładnie na środku
         (znak tekstowy przesuwa się zależnie od metryk czcionki). -->
    <ImageButton Grid.Row="1" Source="icon_add.png" Command="{Binding NewReportCommand}" AutomationId="ReportsAdd"
                 Padding="16" WidthRequest="60" HeightRequest="60" CornerRadius="30"
                 BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                 HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,28"
                 SemanticProperties.Description="{loc:Translate Reports_New}" />
    </Grid>
</pages:BasePage>
