<?xml version="1.0" encoding="utf-8" ?>
<!--
  Powiadomienia push: „Włącz powiadomienia” — ekran wyjaśniający (modal) po PIERWSZYM logowaniu, zanim pojawi się systemowa prośba.
  Użytkownik wie, po co zgoda, więc częściej ją daje; „Nie teraz” nie spala jedynej systemowej prośby (iOS pyta raz).
-->
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
                xmlns:pages="clr-namespace:FieldReport.App.Pages"
                xmlns:loc="clr-namespace:FieldReport.App.MarkupExtensions"
                xmlns:vm="clr-namespace:FieldReport.Core.ViewModels;assembly=FieldReport.Core"
                x:Class="FieldReport.App.Pages.NotificationPrimingPage"
                x:DataType="vm:NotificationPrimingViewModel"
                ios:Page.ModalPresentationStyle="FullScreen"
                IsHeaderVisible="False">
    <Grid RowDefinitions="*,Auto" Padding="24,48,24,32">
        <VerticalStackLayout VerticalOptions="Center" Spacing="16">
            <Image Source="icon_notifications.png" WidthRequest="96" HeightRequest="96" HorizontalOptions="Start" />
            <Label Text="{loc:Translate Priming_Title}" Style="{StaticResource Headline}" FontSize="26" />
            <Label Text="{loc:Translate Priming_Message}" Style="{StaticResource Body}" FontSize="16" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate Priming_BulletAssigned}" Style="{StaticResource Body}" />
                    <Label Text="{loc:Translate Priming_BulletStatus}" Style="{StaticResource Body}" />
                    <Label Text="{loc:Translate Priming_BulletSettings}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Button Text="{loc:Translate Priming_Enable}" Command="{Binding EnableCommand}" AutomationId="PrimingEnable" />
            <Button Text="{loc:Translate Priming_NotNow}" Style="{StaticResource SecondaryButton}" Command="{Binding NotNowCommand}"
                    AutomationId="PrimingNotNow" />
        </VerticalStackLayout>
    </Grid>
</pages:BasePage>
