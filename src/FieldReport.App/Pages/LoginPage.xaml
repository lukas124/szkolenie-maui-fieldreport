<?xml version="1.0" encoding="utf-8" ?>
<!-- Logowanie technika. „Zaloguj” aktywne tylko przy poprawnych danych (CanExecute z ICredentialsValidator). -->
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:FieldReport.App.Pages"
                xmlns:loc="clr-namespace:FieldReport.App.MarkupExtensions"
                xmlns:vm="clr-namespace:FieldReport.Core.ViewModels;assembly=FieldReport.Core"
                x:Class="FieldReport.App.Pages.LoginPage"
                x:DataType="vm:LoginViewModel"
                IsHeaderVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,72,24,32" Spacing="12">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="88" HeightRequest="88" HorizontalOptions="Start">
                <Image Source="logo_mark.png" WidthRequest="72" HeightRequest="72" />
            </Border>
            <Label Text="FieldReport" Style="{StaticResource Headline}" Margin="0,16,0,0" />
            <Label Text="{loc:Translate Login_Subtitle}" Style="{StaticResource Body}" Margin="0,0,0,16" />

            <Label Text="{loc:Translate Login_Email}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource InputFrame}">
                <Entry Text="{Binding Email}" Placeholder="{loc:Translate Login_EmailPlaceholder}"
                       Keyboard="Email" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                       ReturnType="Next" AutomationId="LoginEmail" />
            </Border>

            <Label Text="{loc:Translate Login_Pin}" Style="{StaticResource SectionHeader}" Margin="0,8,0,0" />
            <Border Style="{StaticResource InputFrame}">
                <Entry Text="{Binding Pin}" Placeholder="{loc:Translate Login_PinPlaceholder}"
                       IsPassword="True" Keyboard="Numeric" MaxLength="6" ReturnType="Go"
                       ReturnCommand="{Binding SignInCommand}" AutomationId="LoginPin" />
            </Border>

            <Button Text="{loc:Translate Login_SignIn}" Command="{Binding SignInCommand}" Margin="0,16,0,0" AutomationId="LoginSignIn" />
            <Label Text="{loc:Translate Login_TrainingHint}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
