<?xml version="1.0" encoding="utf-8" ?>
<!-- Start aplikacji: błąd startu → ekran błędu z „Spróbuj ponownie” (nigdy crash). -->
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:FieldReport.App.Pages"
                xmlns:loc="clr-namespace:FieldReport.App.MarkupExtensions"
                xmlns:vm="clr-namespace:FieldReport.Core.ViewModels;assembly=FieldReport.Core"
                x:Class="FieldReport.App.Pages.StartupErrorPage"
                x:DataType="vm:StartupErrorViewModel"
                IsHeaderVisible="False">
    <VerticalStackLayout VerticalOptions="Center" Padding="32" Spacing="16">
        <Image Source="empty_reports.png" WidthRequest="96" HeightRequest="96" HorizontalOptions="Center" />
        <Label Text="{loc:Translate StartupError_Title}" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
        <Label Text="{loc:Translate StartupError_Message}" Style="{StaticResource Body}" HorizontalTextAlignment="Center" />
        <Button Text="{loc:Translate StartupError_Retry}" Command="{Binding RetryCommand}" Margin="0,16,0,0" />
    </VerticalStackLayout>
</pages:BasePage>
