<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core: modele, usługi, ViewModele, prezentacja. BEZ MAUI (dzięki temu testy działają bez emulatora). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FieldReport.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM: ObservableObject, [ObservableProperty], [RelayCommand] (generatory kodu) -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- SQLite (praca offline): sqlite-net (ORM-lite) + natywna biblioteka SQLite -->
    <PackageReference Include="sqlite-net-pcl" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" />
    <!-- tylko typy wyjątków odporności HTTP (Errors.Network) -->
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldReport.Tests" />
  </ItemGroup>

</Project>
