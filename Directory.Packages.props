<Project>
  <!-- Centralne zarządzanie wersjami pakietów NuGet (jedno miejsce na wersje) -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Wersje z tego pliku obowiązują też dla pakietów przechodnich (tu: natywny SQLite, patrz niżej) -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- App -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- App: gotowe konwertery, Snackbar i inne dodatki MAUI -->
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.1" />
    <!-- App: powiadomienia push. Plugin.Firebase 4.x (net9.0-android/ios) działa z .NET 10 / MAUI 10 -->
    <PackageVersion Include="Plugin.Firebase.CloudMessaging" Version="4.0.1" />
    <!-- App: IHttpClientFactory, typed clients -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <!-- App: odporność HttpClient (retry tylko bezpiecznych metod, timeouty, circuit breaker) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <!-- Core: typy wyjątków Polly (TimeoutRejectedException, BrokenCircuitException) w HttpResultExtensions -->
    <PackageVersion Include="Polly.Core" Version="8.6.6" />
    <!-- Core: lokalna baza (praca offline). bundle_green = natywny SQLite dla Androida (e_sqlite3) i systemowy na iOS -->
    <PackageVersion Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageVersion Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <!-- bundle_green 2.1.11 (ostatnia wersja) ciągnie natywny SQLite z luką GHSA-2m69-gcr7-jv3q (NU1903) —
         przypinamy poprawione biblioteki natywne 2.1.13 -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3.ios" Version="2.1.13" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
  </ItemGroup>
</Project>
